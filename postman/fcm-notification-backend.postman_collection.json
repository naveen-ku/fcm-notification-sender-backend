    {
      "id": "59a21dcd-5a9f-4d0f-9ad8-0507945f0772",
      "name": "Reject Missing Target",
      "description": "No target field, so validation fails with 400 before FCM is called.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Error is reported on target\", () => {",
              "  const paths = pm.response.json().error.details.map((d) => d.path);",
              "  pm.expect(paths).to.include(\"target\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notification\": {\n    \"title\": \"Hi\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/notifications/send",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "notifications", "send"]
        }
      },
      "response": []
    },
    {
      "id": "fe87e9c1-c1b6-4ebd-8b01-fbd96835cd72",
      "name": "Reject iOS Fields",
      "description": "Only Android is supported, so `apns` (and `webpush`) are rejected with 400.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Error names the apns key\", () => {",
              "  const messages = pm.response.json().error.details.map((d) => d.message);",
              "  pm.expect(messages.join()).to.include('\"apns\"');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"topic\": \"all\",\n  \"data\": {\n    \"kind\": \"sync\"\n  },\n  \"apns\": {}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/notifications/send",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "notifications", "send"]
        }
      },
      "response": []
    },
    {
      "id": "02f47e04-fd63-46bd-bcf1-189eef31d06c",
      "name": "Reject REST-Style TTL",
      "description": "Field names and units follow firebase-admin, not the FCM REST docs: `ttl` is milliseconds (`3600000`), not `\"3600s\"`.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Error is reported on android.ttl\", () => {",
              "  const paths = pm.response.json().error.details.map((d) => d.path);",
              "  pm.expect(paths).to.include(\"android.ttl\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"topic\": \"all\",\n  \"data\": {\n    \"kind\": \"sync\"\n  },\n  \"android\": {\n    \"ttl\": \"3600s\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/notifications/send",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "notifications", "send"]
        }
      },
      "response": []
    },
    {
      "id": "83c6a124-b43d-4535-87bb-9c041ccf98e0",
      "name": "Reject Reserved Data Key",
      "description": "FCM reserves `from`, `message_type` and keys starting with `google` or `gcm`.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Error is reported on data.google.sent_time\", () => {",
              "  const paths = pm.response.json().error.details.map((d) => d.path);",
              "  pm.expect(paths).to.include(\"data.google.sent_time\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"topic\": \"all\",\n  \"data\": {\n    \"google.sent_time\": \"1\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/notifications/send",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "notifications", "send"]
        }
      },
      "response": []
    },
