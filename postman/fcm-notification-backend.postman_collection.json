        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fid\": \"{{deviceFid}}\",\n  \"notification\": {\n    \"title\": \"Budget alert\",\n    \"body\": \"You have spent 90% of your monthly budget\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/notifications/send",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "notifications", "send"]
