      "response": []
    },
    {
      "id": "eeba0f65-6818-4d6b-a97f-32586b5b4f62",
      "name": "Send Notification By FIDs",
      "description": "Delivers to up to 500 Firebase Installation IDs in one call.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"FCM accepted the message\", () => {",
              "  pm.expect(pm.response.json().successCount).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
