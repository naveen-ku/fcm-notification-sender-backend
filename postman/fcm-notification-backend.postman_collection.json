        "body": {
          "mode": "raw",
          "raw": "{\n  \"fids\": [\n    \"{{deviceFid}}\"\n  ],\n  \"notification\": {\n    \"title\": \"Budget alert\",\n    \"body\": \"You have spent 90% of your monthly budget\"\n  }\n}",
          "options": {
